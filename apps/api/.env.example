# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vnkc?schema=public"

# Server
PORT=3100
NODE_ENV=development

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:3100"

# Typesense (for full-text search)
TYPESENSE_HOST="localhost"
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL="http"
TYPESENSE_API_KEY="xyz"

# Cloudflare R2 (optional, for file storage)
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET_NAME="vnkc-files"
