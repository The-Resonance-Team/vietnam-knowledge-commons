// Vietnam Knowledge Commons - Prisma Schema
// Two domains: Administrative units + Legal corpus

generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
  // url is now in prisma.config.ts
}

// ============ Administrative Units ============

enum AdminUnitLevel {
  province
  district
  ward
}

model AdministrativeUnit {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique // GSO statistical code
  name        String        // Vietnamese name
  nameEn      String?       @map("name_en") // English name (optional)
  level       AdminUnitLevel
  validFrom   DateTime      @map("valid_from")
  validTo     DateTime?     @map("valid_to") // null = current
  parentId    String?       @map("parent_id") @db.Uuid
  population  Int?
  areaKm2     Float?        @map("area_km2")
  sourceUrl   String?       @map("source_url")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  parent       AdministrativeUnit?  @relation("UnitHierarchy", fields: [parentId], references: [id])
  children     AdministrativeUnit[] @relation("UnitHierarchy")
  predecessors AdminUnitRelation[]  @relation("PredecessorUnits")
  successors   AdminUnitRelation[]  @relation("SuccessorUnits")
  legalDocs    LegalDocument[]      @relation("DocumentAppliesToUnits")

  @@map("administrative_units")
}

// Junction table for merger relationships (many-to-many)
model AdminUnitRelation {
  id              String   @id @default(uuid()) @db.Uuid
  predecessorId   String   @map("predecessor_id") @db.Uuid
  successorId     String   @map("successor_id") @db.Uuid
  relationshipType String  @map("relationship_type") @default("merger") // merger, split, rename
  effectiveDate   DateTime @map("effective_date")
  createdAt       DateTime @default(now()) @map("created_at")

  predecessor AdministrativeUnit @relation("PredecessorUnits", fields: [predecessorId], references: [id])
  successor   AdministrativeUnit @relation("SuccessorUnits", fields: [successorId], references: [id])

  @@unique([predecessorId, successorId, relationshipType])
  @@map("admin_unit_relations")
}

// ============ Legal Documents ============

// Mirrors the canonical vocabulary in schemas/legal-document.schema.json,
// which ADR-0002 makes authoritative. Prisma enum identifiers cannot contain
// hyphens, so each value @maps to the exact canonical string; sync-db writes
// the JSON value straight through. Vietnamese equivalents are noted for
// readers coming from the domain rather than the schema.
enum DocumentType {
  constitution                                       // hiến pháp
  code                                               // bộ luật
  law                                                // luật
  ordinance                                          // pháp lệnh
  resolution                                         // nghị quyết
  decree                                             // nghị định
  decision                                           // quyết định
  circular                                           // thông tư
  joint_circular        @map("joint-circular")       // thông tư liên tịch
  directive                                          // chỉ thị
  official_dispatch     @map("official-dispatch")    // công văn
  treaty                                             // hiệp định
  consolidated_document @map("consolidated-document") // văn bản hợp nhất
  promulgation_order    @map("promulgation-order")   // lệnh
  historic_ordinance    @map("historic-ordinance")   // sắc lệnh
  other                                              // khác
}

// How documentType was derived. The Vietnamese title prefix names the type
// ('Thông tư'); the number suffix names the issuing body ('TT-BYT'). They are
// orthogonal, so the prefix is authoritative and the suffix only a fallback.
enum DocumentTypeBasis {
  title_prefix
  number_suffix
  fallback
}

// Whether the source page was actually retrieved, or only discovered via a
// listing page. Discovered records have a title but no dates and no body.
enum FetchStatus {
  fetched
  discovered
}

enum DocumentScope {
  nationwide
  provincial
  district
  ward
}

model LegalDocument {
  id              String         @id @default(uuid()) @db.Uuid
  // Published identity, e.g. 'vnkc:legal-doc:21490'. Derived 1:1 from the
  // source page, so it is unique alongside sourceUrl rather than instead of it.
  canonicalId     String         @unique @map("canonical_id")
  documentType    DocumentType   @map("document_type")
  documentTypeBasis DocumentTypeBasis @map("document_type_basis")
  // Null when the title carried no parseable number (~1,260 rows); the
  // unparsed token is kept in documentNumberRaw rather than guessed at.
  documentNumber  String?        @map("document_number") // e.g., '01/2024/QH15'
  documentNumberRaw String?      @map("document_number_raw")
  // A citation, not a subject: 'Thông tư 28/2026/TT-BYT của Bộ Y tế'.
  citationTitle   String?        @map("citation_title")
  // The document's actual topic, de-diacriticized, from the URL slug.
  subjectSlug     String?        @map("subject_slug")
  titleEn         String?        @map("title_en") // English title (optional)
  // Null on discovered-but-unfetched records.
  issueDate       DateTime?      @map("issue_date")
  effectiveDate   DateTime?      @map("effective_date")
  expiryDate      DateTime?      @map("expiry_date") // null = still valid
  // Verbatim body token from the number ('TT-BYT'). Not mapped to a display
  // name: 1,106 distinct tokens, top 30 cover only 80% of rows.
  issuingAuthorityCode String?   @map("issuing_authority_code")
  issuingBody     String?        @map("issuing_body") // e.g., 'National Assembly'
  fullText        String?        @map("full_text") // Full text content
  fetchStatus     FetchStatus    @default(discovered) @map("fetch_status")
  contentChecksum String?        @map("content_checksum")
  scope           DocumentScope  @default(nationwide)
  sourceId        String         @map("source_id") @db.Uuid
  sourceUrl       String         @map("source_url")
  retrievedAt     DateTime       @map("retrieved_at")
  keywords        String[]       @default([])
  abstract        String?
  isDuplicate     Boolean        @default(false) @map("is_duplicate")
  canonicalDocId  String?        @map("canonical_doc_id") @db.Uuid // points to canonical if duplicate
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  source       Source          @relation(fields: [sourceId], references: [id])
  files        File[]
  appliesToUnits AdministrativeUnit[] @relation("DocumentAppliesToUnits")
  canonicalDoc LegalDocument?  @relation("DuplicateDocs", fields: [canonicalDocId], references: [id])
  duplicates   LegalDocument[] @relation("DuplicateDocs")

  // Identity is the source page, not the document number. The number is a
  // parsed attribute that is null or ambiguous on ~4.5% of rows, and dates
  // are absent on the 10,005 discovered-only records, so the old
  // [documentNumber, issueDate, documentType] key was unsatisfiable.
  // See ADR-0004.
  @@unique([sourceUrl])
  @@index([documentNumber])
  @@index([fetchStatus])
  @@index([documentType])
  @@index([issueDate])
  @@index([effectiveDate])
  @@index([scope])
  @@map("legal_documents")
}

// ============ Files ============

enum FileType {
  pdf
  docx
  xlsx
  other
}

model File {
  id              String   @id @default(uuid()) @db.Uuid
  legalDocumentId String   @map("legal_document_id") @db.Uuid
  filename        String
  fileType        FileType @map("file_type")
  fileSizeBytes   Int      @map("file_size_bytes")
  storageUrl      String   @map("storage_url") // R2 URL
  sourceUrl       String   @map("source_url") // Original download URL
  checksumSha256  String   @map("checksum_sha256")
  retrievedAt     DateTime @map("retrieved_at")
  createdAt       DateTime @default(now()) @map("created_at")

  legalDocument LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Cascade)

  @@index([legalDocumentId])
  @@map("files")
}

// ============ Sources ============

enum SourceType {
  legal
  administrative
  gazette
  ministry
}

model Source {
  id               String     @id @default(uuid()) @db.Uuid
  name             String     @unique // e.g., 'vbpl.vn'
  baseUrl          String     @map("base_url")
  sourceType       SourceType @map("source_type")
  license          String     @default("public domain")
  rateLimitSeconds Float      @default(1.5) @map("rate_limit_seconds")
  description      String?
  contact          String?
  createdAt        DateTime   @default(now()) @map("created_at")

  legalDocuments LegalDocument[]

  @@map("sources")
}
